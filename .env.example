# =============================================================================
# INCOIS Ocean Visualization — Environment Variables (copy to .env)
# =============================================================================
# Backend — Express (backend/.env)
PORT=8000
NODE_ENV=development
# CORS allowed origins (comma separated or *). Example: https://your-frontend.vercel.app,http://localhost:5173
CORS_ORIGIN=*
# ERDDAP / INCOIS upstream endpoints
ERDDAP_IFREMER_BASE=https://erddap.ifremer.fr/erddap/tabledap/ArgoFloats.json
ERDDAP_IFREMER_INDEX=https://erddap.ifremer.fr/erddap/index.json
ERDDAP_INCOIS_BASE=https://erddap.incois.gov.in/erddap
# Optional: verified real gridded model dataset. The backend returns
# model.available=false until these match a real dataset's .dds metadata.
MODEL_DATASET_ID=
MODEL_VARIABLES=temp:thetao,psal:so
MODEL_DIMENSIONS=time,depth,latitude,longitude
INCOIS_WFS_TIDE_URL=https://incois.gov.in/geoserver/Insitu_TideGauges_Tsunami/ows
# Optional: request timeouts (ms) — increased for public ERDDAP (international, large tables)
ERDDAP_TIMEOUT_MS=35000
HEALTH_PING_TIMEOUT_MS=10000

# Frontend — Vite (frontend/.env) — all VITE_ prefixed
# Local dev: http://localhost:8000 — Production: https://your-backend.onrender.com or leave empty for same-origin
VITE_BACKEND_URL=http://localhost:8000
VITE_ERDDAP_IFREMER_BASE=https://erddap.ifremer.fr/erddap/tabledap/ArgoFloats.json
VITE_ERDDAP_PROXY_PATH=/erddap-proxy
VITE_ERDDAP_INCOIS_BASE=https://erddap.incois.gov.in/erddap
VITE_INCOIS_WFS_URL=https://incois.gov.in/geoserver/Insitu_TideGauges_Tsunami/ows
# Vite dev proxy target (local backend)
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000
