# Backend — copy to backend/.env
PORT=8000
NODE_ENV=development
CORS_ORIGIN=*
ERDDAP_IFREMER_BASE=https://erddap.ifremer.fr/erddap/tabledap/ArgoFloats.json
# Leave blank unless an official BGC provider is configured. The Ifremer
# ArgoFloats-synthetic-BGC dataset is intentionally not used as science data.
ERDDAP_BGC_BASE=
ERDDAP_IFREMER_INDEX=https://erddap.ifremer.fr/erddap/index.json
ERDDAP_INCOIS_BASE=https://erddap.incois.gov.in/erddap
# Verified INCOIS Argo objective-analysis grid. Dataset metadata:
# https://erddap.incois.gov.in/erddap/griddap/incois_argo_10d_VAM.dds
MODEL_DATASET_ID=incois_argo_10d_VAM
MODEL_VARIABLES=temp:TEMP,psal:SAL
MODEL_DIMENSIONS=time,ZAX,latitude,longitude
MODEL_TIME_TOLERANCE_DAYS=120
INCOIS_WFS_TIDE_URL=https://incois.gov.in/geoserver/Insitu_TideGauges_Tsunami/ows
ERDDAP_TIMEOUT_MS=35000
HEALTH_PING_TIMEOUT_MS=10000
