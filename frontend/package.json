{
  "name": "frontend",
  "version": "1.0.0",
  "description": "INCOIS Ocean Visualization — 3D Frontend (Vite + React + Three.js)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "serve": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .js,.jsx || echo 'eslint not configured - syntax check via vite build'",
    "lint:fix": "eslint . --ext .js,.jsx --fix || echo 'eslint not configured'",
    "format": "prettier --write \"**/*.{js,jsx,css,json,md}\" || echo 'prettier not configured'",
    "typecheck": "tsc --noEmit --skipLibCheck || echo 'no tsconfig - skip'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/fiber": "^9.7.0",
    "framer-motion": "^13.2.0",
    "gsap": "^3.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.12.4",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "vite": "^8.2.2"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
